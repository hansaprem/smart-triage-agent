{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/nlp/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "memory": 2048,
      "maxDuration": 60,
      "includeFiles": [
        "nlp/models/trievo_ner/**",
        "nlp/evaluation/*.json",
        "nlp/inference/onnx_predict.py"
      ],
      "excludeFiles": [
        "nlp/data/**",
        "nlp/tests/**",
        "nlp/preprocessing/**",
        "nlp/training/**"
      ]
    }
  }
}