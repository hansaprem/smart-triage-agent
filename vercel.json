{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/nlp/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "memory": 2048,
      "maxDuration": 60,
      "includeFiles": "nlp/**",
      "excludeFiles": "{nlp/data/raw/**,nlp/data/processed/**,nlp/tests/**}"
    }
  }
}